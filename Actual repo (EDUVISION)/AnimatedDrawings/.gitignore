# ─────────────────────────────────────────────────────────────
#  .gitignore  —  AnimatedDrawings MVP (Collaborative Edition)
# ─────────────────────────────────────────────────────────────
#
#  👋 Hey collaborators! This file only ignores things that
#  genuinely shouldn't be shared (secrets, large binaries,
#  OS/editor junk). Everything else is tracked so we all
#  stay on the same page.
#
#  If you add a new rule, please add a comment explaining WHY.
# ─────────────────────────────────────────────────────────────


# ── 🔐 SECRETS — NEVER commit these ──────────────────────────
# Each person must create their own .env locally.
# See README.md → "Setup for Collaborators" for instructions.
.env
torchserve/logs/.env


# ── 🗑️ OS & EDITOR JUNK ──────────────────────────────────────
# These are machine-specific files that mean nothing to teammates.
**/.DS_Store
**/__pycache__/
**/*.pyc
**/*.pyo
.vscode/
.idea/


# ── 📦 BUILD & PACKAGE ARTIFACTS ─────────────────────────────
# Auto-generated by pip/setuptools — teammates regenerate by: pip install -e .
*.egg-info/
animated_drawings.egg-info/
dist/
build/


# ── 🤖 ML MODEL FILES ────────────────────────────────────────
# Large binary files (~100MB+). Download separately per README.
**/*.mar


# ── 🎬 GENERATED OUTPUT FILES ────────────────────────────────
# Animation outputs each person generates locally.
# We skip these because they can be 5–100 MB each.
**/*.mp4
**/*.gif
!media/*.gif


# ── 📁 ANNOTATION FOLDERS ────────────────────────────────────
# Auto-generated by run.py / run_my_drawing.py per image.
annotations_*/
my_output/


# ── 🌐 FRONTEND / NODE ───────────────────────────────────────
node_modules/
.parcel-cache/


# ── 📝 LOGS ──────────────────────────────────────────────────
**/log.txt
torchserve/logs/


# ─────────────────────────────────────────────────────────────
#  ✅ WHAT WE DO TRACK (not ignored):
#    - run.py, run_my_drawing.py, animate.py
#    - image_to_annotations_claude.py  (Gemini pipeline)
#    - examples/config/                (motion + retarget configs)
#    - animated_drawings/              (library source)
#    - .env.example                    (template for .env setup)
#    - *.png / *.jpg drawing images    (small, useful to share)
# ─────────────────────────────────────────────────────────────
